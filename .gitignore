# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Raw datasets
data/raw/*.zip
data/btsc_raw/
data/dits_raw/

# Large generated caches
data/cache/*.npy

# Generated experiment outputs / model files
runs/**/*.pt
runs/**/*.npz

# Keep generated run metadata/results, but ignore temporary files
*.tmp
*.log

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

CLAUDE.local.md

# Large data outputs anywhere in the repo (the existing runs/**/*.npz and data/cache/*.npy stay)
*.npz
*.npy

# Never ignore these. Kept last because the last matching rule wins.
# configs/** and docs/** (not configs/, docs/) so files inside are re-included too
!**/*_summary.json
!LOG*.md
!env_*.txt
!configs/**
!docs/**

# Third-party papers: kept locally, not redistributed (citations, URLs and SHA-256 in LOG_r8_stage6_entry.md)
docs/papers/

# Personal local settings (not shared)
.claude/settings.local.json
